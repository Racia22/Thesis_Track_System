# Environment variables ThesisTrack reads.
#
# Local dev: `mvn spring-boot:run` activates the `dev` profile, whose defaults
# (application-dev.yml) match the values below, so nothing needs exporting.
#
# Production: run WITHOUT the dev profile. DB_USERNAME, DB_PASSWORD and JWT_SECRET
# have no fallback there and the app will refuse to start until they are set.
# Generate a JWT secret with e.g.:  openssl rand -base64 48

DB_HOST=localhost
DB_PORT=5432
DB_NAME=thesistrack
DB_USERNAME=thesistrack_app
DB_PASSWORD=thesistrack_app_pw

JWT_SECRET=<at-least-32-random-bytes>
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

CORS_ALLOWED_ORIGINS=http://localhost:5173

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
